const cardsEl = document.getElementById('cards');

function addGroupTitle(title) {
  const div = document.createElement('div');
  div.className = 'group-title';
  div.textContent = title;
  cardsEl.appendChild(div);
}

function addCard(item, marker) {
  const card = document.createElement('div');
  card.className = 'card';
  const photoHtml = item.photo ? `<img class="clickable-photo" src="${item.photo}" style="width:100%;border-radius:8px;margin-bottom:8px;display:block;" />` : '';
  card.innerHTML = `${photoHtml}<div class="card-name">${item.name}</div><div class="card-detail">📍 ${item.detail}</div><span class="card-tag" style="color:${item.color};background:${item.color}1a;">${item.group}</span>`;
  if (item.photo) {
    const imgEl = card.querySelector('img.clickable-photo');
    imgEl.addEventListener('click', (e) => { e.stopPropagation(); openLightbox(item.photo); });
  }
  card.addEventListener('click', () => {
    map.flyTo([item.lat, item.lng], 13, { duration: 1 });
    if (item.group === "Metro") toggleMetroNetworkHighlight();
    if (item.toggleRoute === "bus") toggleSharjahBusRoute();
    if (item.toggleRoute === "taxi") toggleSharjahTaxiRoute();
  });
  card.addEventListener('mouseenter', () => { card.classList.add('active'); if (marker) marker.getElement()?.classList.add('marker-highlight'); });
  card.addEventListener('mouseleave', () => { card.classList.remove('active'); if (marker) marker.getElement()?.classList.remove('marker-highlight'); });
  cardsEl.appendChild(card);
}

// Consolidated-card summaries for groups of repeated/duplicate placements.
// Individual markers still get placed on the map for each location; only the
// SIDEBAR CARD is collapsed into one entry per cardGroup, matching how a
// multi-site product (e.g. "ENOC Digital Network, 67 stations") is shown as
// a single card rather than one per site.
const cardGroupSummaries = {
  "metro-platforms": {
    name: "Metro Platform Screen Walls (8 Stations)",
    detail: "~62 panels/station, both bounds · ADCB, Sharaf DG, Union, BurJuman, Abu Hail, DCC (Deira City Centre), Business Bay, Discovery Gardens · Ref# UAE06",
    photo: "PHOTO_PLATFORM_REF"
  },
  "bus-shelters": {
    name: "Dubai Bus Shelters (8 Locations)",
    detail: "Single face each · Deira x3, Karama x2, Bur Dubai x1, Al Satwa x2 · Red Dot",
    photo: "PHOTO_BUS_SHELTER_REF"
  },
  "sharjah-bus-shelters": {
    name: "Sharjah Bus Shelters (6 Locations)",
    detail: "Single face each · Al Majaz x2, Al Nahdha, Al Musalla, Maysaloon, Al Nasserya · Red Dot · positions approximate, station numbers to confirm",
    photo: "PHOTO_BUS_SHELTER_REF"
  }
};

const groups = ["Hoardings / Billboards", "Metro", "Bus Shelters", "Sharjah", "Airport"];
groups.forEach(g => {
  const groupPlaces = places.filter(p => p.group === g);
  if (groupPlaces.length === 0) return;
  addGroupTitle(`${g} (${groupPlaces.length})`);

  const markersByCardGroup = {}; // collects every marker in this category sharing a cardGroup key
  const nonConsolidatedItems = []; // (item, marker) pairs to render as normal cards, in order
  groupPlaces.forEach(item => {
    const size = 20;
    const marker = L.marker([item.lat, item.lng], { icon: starIcon(item.color, size, !!item.emphasize) }).addTo(map);
    marker.bindTooltip(`<b>${item.group}</b><br>${item.name}`, { direction: 'top', offset: [0,-14] });
    if (item.toggleRoute === "bus") marker.on('click', () => toggleSharjahBusRoute());
    if (item.toggleRoute === "taxi") marker.on('click', () => toggleSharjahTaxiRoute());
    const popupTextHtml = `<div style="font-size:16px;font-weight:700;color:#1a1a1a;margin-bottom:4px;line-height:1.3;">${item.group}</div><div style="font-size:14px;color:#444;line-height:1.4;">${item.name}</div>`;
    if (item.photo) {
      marker.bindPopup(`<div style="max-width:280px;"><img class="clickable-photo" src="${item.photo}" style="width:100%;border-radius:6px;margin-bottom:10px;display:block;"/>${popupTextHtml}</div>`);
      marker.on('popupopen', () => {
        const popupImg = marker.getPopup().getElement().querySelector('img.clickable-photo');
        if (popupImg) popupImg.addEventListener('click', (e) => { e.stopPropagation(); openLightbox(item.photo); });
      });
    } else {
      marker.bindPopup(`<div style="max-width:280px;">${popupTextHtml}</div>`);
    }

    if (item.cardGroup) {
      (markersByCardGroup[item.cardGroup] = markersByCardGroup[item.cardGroup] || []).push(marker);
      return;
    }
    nonConsolidatedItems.push([item, marker]);
  });

  // Render consolidated cards first (so e.g. "Metro Platforms" leads the Metro section),
  // then the remaining individual cards.
  Object.keys(markersByCardGroup).forEach(cardGroupKey => {
    const summary = cardGroupSummaries[cardGroupKey];
    const groupMarkers = markersByCardGroup[cardGroupKey];
    const photo = summary.photo === "PHOTO_PLATFORM_REF" ? PHOTO_PLATFORM : (summary.photo === "PHOTO_BUS_SHELTER_REF" ? PHOTO_BUS_SHELTER : summary.photo);
    const boundsLatLngs = places.filter(p => p.cardGroup === cardGroupKey).map(p => [p.lat, p.lng]);
    const card = document.createElement('div');
    card.className = 'card';
    const photoHtml = photo ? `<img class="clickable-photo" src="${photo}" style="width:100%;border-radius:8px;margin-bottom:8px;display:block;" />` : '';
    card.innerHTML = `${photoHtml}<div class="card-name">${summary.name}</div><div class="card-detail">📍 ${summary.detail}</div><span class="card-tag" style="color:${g === 'Metro' ? GREEN : BLUE};background:${(g === 'Metro' ? GREEN : BLUE)}1a;">${g}</span>`;
    if (photo) {
      const imgEl = card.querySelector('img.clickable-photo');
      imgEl.addEventListener('click', (e) => { e.stopPropagation(); openLightbox(photo); });
    }
    card.addEventListener('click', () => {
      map.fitBounds(boundsLatLngs, { padding: [40,40] });
    });
    card.addEventListener('mouseenter', () => { card.classList.add('active'); groupMarkers.forEach(m => m.getElement()?.classList.add('marker-highlight')); });
    card.addEventListener('mouseleave', () => { card.classList.remove('active'); groupMarkers.forEach(m => m.getElement()?.classList.remove('marker-highlight')); });
    cardsEl.appendChild(card);
  });
  nonConsolidatedItems.forEach(([item, marker]) => addCard(item, marker));
});

